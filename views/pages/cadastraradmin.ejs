<%- include('../partials/head', { titulo: 'Cadastrar Usuário Admin | Taú Sports', css: ['global', 'header', 'footer', 'pedidos', 'components', 'seusdados', 'cadastrarproduto', 'validacao-senha'] }) %>
<body>
<%- include('../partials/header') %>
<main class="paginaUsuario">
    <%- include('../partials/conta-menu', { ativo: 'cadastraradmin' }) %>
    <section class="perfilInformacao cadastroProduto" aria-labelledby="tituloCadastro">
        <div class="cabecalhoPerfil">
            <span class="perfilAdmin">ADMIN</span>
            <h1 id="tituloCadastro">Cadastrar Usuário Admin</h1>
            <p>Crie uma conta com permissão de administrador para a Taú Sports.</p>
        </div>
        <% if (sucesso) { %>
            <div class="mensagemFormulario mensagemSucesso" role="status">Administrador cadastrado com sucesso.</div>
        <% } %>
        <% if (erros.length) { %>
            <div class="mensagemFormulario mensagemErro" role="alert">
                <strong>Revise os campos abaixo:</strong>
                <ul><% erros.forEach(function (mensagem) { %><li><%= mensagem %></li><% }) %></ul>
            </div>
        <% } %>
        <article class="cardFormulario">
            <form action="/administradores" method="post" class="formUsuario" data-validar-senha>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="campoFormulario campoGrande">
                    <label for="nome">Nome completo *</label>
                    <input type="text" id="nome" name="nome" value="<%= valores.nome || '' %>" minlength="3" maxlength="100" autocomplete="name" required>
                </div>
                <div class="campoFormulario">
                    <label for="email">E-mail *</label>
                    <input type="email" id="email" name="email" value="<%= valores.email || '' %>" maxlength="100" autocomplete="off" required>
                </div>
                <div class="campoFormulario">
                    <label for="cpf">CPF *</label>
                    <input type="text" id="cpf" name="cpf" value="<%= valores.cpf || '' %>" inputmode="numeric" maxlength="14" placeholder="000.000.000-00" required>
                </div>
                <div class="campoFormulario">
                    <label for="telefone">Telefone *</label>
                    <input type="tel" id="telefone" name="telefone" value="<%= valores.telefone || '' %>" maxlength="20" placeholder="(00) 00000-0000" required>
                </div>
                <div class="campoFormulario">
                    <label for="senha">Senha *</label>
                    <input type="password" id="senha" name="senha" minlength="8" maxlength="128" autocomplete="new-password" required>
                    
                </div>
                <div class="campoFormulario campoGrande forcaSenha" aria-live="polite">
                    <p data-forca-texto>Força da senha: —</p>
                    <div class="forcaSenhaBarra" data-forca-barra></div>
                    <ul class="requisitosSenha">
                        <li data-requisito="tamanho">De 8 a 128 caracteres</li>
                        <li data-requisito="maiuscula">Uma letra maiúscula (A-Z)</li>
                        <li data-requisito="minuscula">Uma letra minúscula (a-z)</li>
                        <li data-requisito="numero">Um número (0-9)</li>
                        <li data-requisito="especial">Um caractere especial (ex.: ! @ #)</li>
                    </ul>
                    <p class="erroSenha" data-erro-senha role="alert"></p>
                </div>
                <div class="campoFormulario">
                    <label for="confirmarSenha">Confirmar senha *</label>
                    <input type="password" id="confirmarSenha" name="confirmarSenha" minlength="8" maxlength="128" autocomplete="new-password" required>
                </div>
                <div class="acoesFormulario campoGrande">
                    <a href="/seusdados.html" class="cancelarCadastro">Cancelar</a>
                    <button type="submit">Cadastrar Usuário Admin</button>
                </div>
            </form>
        </article>
    </section>
</main>
<%- include('../partials/scripts', { scripts: ['core', 'conta', 'regras-senha', 'validacao-senha-formulario'] }) %>
</body>
</html>
