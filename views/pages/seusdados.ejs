<%- include('../partials/head', {
    titulo: 'Taú Sports | Minha Conta',
    css: ['global', 'header', 'footer', 'pedidos', 'components', 'cards', 'seusdados']
}) %>
<body>

<%- include('../partials/header') %>

<main class="paginaUsuario">
    <%- include('../partials/conta-menu', { ativo: 'seusdados' }) %>

<section class="perfilInformacao" aria-labelledby="tituloSeusDados">
    

    <article class="cardFormulario">
        <div class="cardFormularioCabecalho">
            <h2>Dados pessoais</h2>
            <p>Atualize suas informações de cadastro.</p>
        </div>

        <form class="formUsuario" action="#" method="post">
            <div class="campoFormulario campoGrande">
                <label for="nomeCompleto">Nome completo</label>
                <input
                    type="text"
                    id="nomeCompleto"
                    name="nomeCompleto"
                    placeholder="Alifer Henrique da Silva Maia"
                    autocomplete="name"
                >
            </div>

            <div class="campoFormulario">
                <label for="dataNascimento">Data de nascimento</label>
                <input
                    type="date"
                    id="dataNascimento"
                    name="dataNascimento"
                >
            </div>

            <div class="campoFormulario">
                <label for="telefone">Telefone</label>
                <input
                    type="tel"
                    id="telefone"
                    name="telefone"
                    placeholder="(19) 99999-9999"
                    autocomplete="tel"
                >
            </div>

            <fieldset class="campoFormulario campoGrande grupoOpcoes">
                <legend>Gênero</legend>

                <label class="opcaoRadio" for="generoMasculino">
                    <input
                        type="radio"
                        id="generoMasculino"
                        name="genero"
                        value="masculino"
                    >
                    <span>Masculino</span>
                </label>

                <label class="opcaoRadio" for="generoFeminino">
                    <input
                        type="radio"
                        id="generoFeminino"
                        name="genero"
                        value="feminino"
                    >
                    <span>Feminino</span>
                </label>
            </fieldset>

            <div class="acoesFormulario campoGrande">
                <button type="submit">Salvar dados pessoais</button>
            </div>
        </form>
    </article>

    <article class="cardFormulario">
        <div class="cardFormularioCabecalho">
            <h2>Dados de acesso</h2>
            <p>Altere seu e-mail, senha e preferências de comunicação.</p>
        </div>

        <form class="formUsuario" action="#" method="post">
            <div class="campoFormulario campoGrande">
                <label for="emailUsuario">E-mail</label>
                <input
                    type="email"
                    id="emailUsuario"
                    name="emailUsuario"
                    placeholder="alifer.maia@sou.fae.br"
                    autocomplete="email"
                >
            </div>

            <div class="acoesFormulario campoGrande acoesAcesso">
                <button type="button">Alterar e-mail</button>
                <button type="button" class="botaoSecundario">Alterar senha</button>
            </div>

            <fieldset class="campoFormulario campoGrande grupoOpcoes">
                <legend>Preferências</legend>

                <label class="opcaoCheckbox" for="receberEmail">
                    <input
                        type="checkbox"
                        id="receberEmail"
                        name="preferencias"
                        value="email"
                    >
                    <span>Quero receber ofertas e novidades da Taú Sports por e-mail</span>
                </label>

                <label class="opcaoCheckbox" for="receberWhatsapp">
                    <input
                        type="checkbox"
                        id="receberWhatsapp"
                        name="preferencias"
                        value="whatsapp"
                    >
                    <span>Quero receber ofertas e novidades por WhatsApp</span>
                </label>

                <label class="opcaoCheckbox" for="notificacoesPedidos">
                    <input
                        type="checkbox"
                        id="notificacoesPedidos"
                        name="preferencias"
                        value="pedidos-whatsapp"
                    >
                    <span>Quero receber notificações dos meus pedidos por WhatsApp</span>
                </label>
            </fieldset>

            <div class="acoesFormulario campoGrande">
                <button type="submit">Salvar dados de acesso</button>
            </div>
        </form>
    </article>
</section>
</main>

<%- include('../partials/scripts', { scripts: ['core', 'conta'] }) %>
</body>
</html>
