<%- include('../partials/head', {
    titulo: 'Login | Tau Sports',
    css: ['global', 'components', 'login', 'header', 'footer']
}) %>
<body>

<%- include('../partials/header-login') %>

<main class="login-page">

        <section class="login-container">

            <!-- LADO ESQUERDO -->
            <div class="login-banner">

                <div class="overlay"></div>

                

            </div>

            <!-- LADO DIREITO -->
            <div class="login-box">

                <div class="login-header">

                    <h1>
                        Bem-vindo de volta
                    </h1>

                    <p>
                        Faça login para continuar
                    </p>

                </div>

                <!-- FORM -->
                <% if (erro) { %>
                    <p class="mensagemFormulario mensagemErro" role="alert"><%= erro %></p>
                <% } %>
                <form class="login-form" action="/login" method="post">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="next" value="<%= proximo %>">

                    <div class="input-group">

                        <label for="email">
                            E-mail
                        </label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            value="<%= valores.email || '' %>"
                            autocomplete="username"
                            maxlength="254"
                            class="input"
                            placeholder="Digite seu e-mail"
                            required
                        >

                    </div>

                    <div class="input-group">

                        <label for="senha">
                            Senha
                        </label>

                        <input
                            type="password"
                            id="senha"
                            name="senha"
                            autocomplete="current-password"
                            maxlength="128"
                            class="input"
                            placeholder="Digite sua senha"
                            required
                        >

                    </div>

                    <!-- OPÇÕES -->
                    <div class="login-options">

                        <a href="#" class="esqueceuASenha">
                            Esqueceu a senha?
                        </a>

                    </div>

                    <!-- BOTÃO -->
                    <button 
                        type="submit"
                        class="btn btn-primary login-btn"
                    >
                        Entrar
                    </button>

                </form>

                <!-- DIVISOR -->
                <div class="divider">
                    <span>ou</span>
                </div>

                <!-- LOGIN SOCIAL -->
                <div class="social-login">

                    <button class="social-btn">

                        <img 
                            src="/imagensUCE/google.png" 
                            alt="Google"
                        >

                        <span>
                            Continuar com Google
                        </span>

                    </button>

                    <button class="social-btn facebook">

                        <img 
                            src="/imagensUCE/facebookBranco.svg" 
                            alt="Facebook"
                        >

                        <span>
                            Continuar com Facebook
                        </span>

                    </button>

                </div>

                <!-- FOOTER -->
                <div class="login-footer">

                    <p>
                        Ainda não possui conta?
                        <a href="/cadastro.html">
                        Criar conta Tau Sports
                    </a>
                    </p>

                    

                </div>

            </div>

        </section>

    </main>

<%- include('../partials/scripts', { scripts: ['core', 'conta'] }) %>
</body>
</html>
