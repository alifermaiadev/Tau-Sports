<%- include('../partials/head', { titulo: 'Cadastrar Produto | Taú Sports', css: ['global', 'header', 'footer', 'pedidos', 'components', 'seusdados', 'cadastrarproduto'] }) %>
<body>
<%- include('../partials/header') %>
<main class="paginaUsuario">
    <%- include('../partials/conta-menu', { ativo: 'cadastrarproduto' }) %>
    <section class="perfilInformacao cadastroProduto" aria-labelledby="tituloCadastro">
        <div class="cabecalhoPerfil"><span class="perfilAdmin">ADMIN</span><h1 id="tituloCadastro">Cadastrar</h1><p>Cadastre categorias, marcas, gêneros e produtos para a Taú Sports.</p></div>
        <% if (sucesso) { %>
            <div class="mensagemFormulario mensagemSucesso" role="status"><%= mensagemSucesso || "Produto cadastrado com sucesso." %> <% if (produtoCadastrado) { %><a href="/produto.html?id=<%= produtoCadastrado.id %>">Ver produto na loja</a><% } %></div>
        <% } %>
        <% if (erros.length) { %>
            <div class="mensagemFormulario mensagemErro" role="alert"><strong>Revise os campos abaixo:</strong><ul><% erros.forEach(function (mensagem) { %><li><%= mensagem %></li><% }) %></ul></div>
        <% } %>
        <div class="campoFormulario campoGrande"><label for="tipoCadastro">O que deseja cadastrar?</label>
            <select id="tipoCadastro"><option value="produto">Produto</option><option value="categoria" <%= valores.registro === 'categoria' ? 'selected' : '' %>>Categoria</option><option value="marca" <%= valores.registro === 'marca' ? 'selected' : '' %>>Marca</option><option value="genero" <%= valores.registro === 'genero' ? 'selected' : '' %>>Gênero</option></select>
        </div>
        <% ['categoria','marca','genero'].forEach(function (item) { %>
        <article class="cardFormulario formularioOpcao" data-formulario="<%= item %>" hidden>
          <form action="/cadastros/<%= item %>" method="post" class="formUsuario">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="campoFormulario campoGrande"><label for="nome-<%= item %>">Nome de <%= item %> *</label><input id="nome-<%= item %>" name="nome" required minlength="2" maxlength="60" placeholder="Informe o nome"></div>
          <div class="acoesFormulario campoGrande"><button type="submit">Cadastrar <%= item %></button></div></form>
        </article>
        <% }) %>
        <% if (editando) { %><p><a class="cancelarCadastro" href="/cadastrarproduto.html">Novo cadastro</a></p><% } %>
        <article class="cardFormulario formularioOpcao" data-formulario="produto">
            <form action="<%= editando ? '/produtos/' + encodeURIComponent(editando.id) + '/editar' : '/produtos' %>" method="post" class="formUsuario">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="campoFormulario campoGrande"><label for="nome">Nome do produto *</label><input type="text" id="nome" name="nome" value="<%= valores.nome || '' %>" minlength="3" maxlength="100" required placeholder="Ex.: Tênis Adidas Campus"></div>
                <div class="campoFormulario"><label for="marca">Marca *</label><select id="marca" name="marca" required><option value="">Selecione</option><% marcas.forEach(function (nome) { %><option value="<%= nome %>" <%= valores.marca === nome ? 'selected' : '' %>><%= nome %></option><% }) %></select></div>
                <div class="campoFormulario"><label for="categoria">Categoria *</label><select id="categoria" name="categoria" required><option value="">Selecione</option><% Object.entries(categorias).forEach(function ([valor, rotulo]) { %><option value="<%= valor %>" <%= valores.categoria === valor ? 'selected' : '' %>><%= rotulo %></option><% }) %></select></div>
                <div class="campoFormulario"><label for="genero">Público *</label><select id="genero" name="genero" required><option value="">Selecione</option><% Object.entries(generos).forEach(function ([valor, rotulo]) { %><option value="<%= valor %>" <%= valores.genero === valor ? 'selected' : '' %>><%= rotulo %></option><% }) %></select></div>
                <div class="campoFormulario"><label for="preco">Preço de venda (R$) *</label><input type="number" id="preco" name="preco" value="<%= valores.preco || '' %>" min="0.01" max="99999999.99" step="0.01" required></div>
                <div class="campoFormulario"><label for="precoDe">Preço anterior (R$)</label><input type="number" id="precoDe" name="precoDe" value="<%= valores.precoDe || '' %>" min="0.01" max="99999999.99" step="0.01"><small>Opcional. Deve ser maior que o preço de venda.</small></div>
                <div class="campoFormulario"><label for="descontoPix">Desconto no PIX (%)</label><input type="number" id="descontoPix" name="descontoPix" value="<%= valores.descontoPix || '0' %>" min="0" max="99" step="1"></div>
                <div class="campoFormulario"><label for="parcelas">Quantidade de parcelas</label><input type="number" id="parcelas" name="parcelas" value="<%= valores.parcelas || '1' %>" min="1" max="10" step="1"></div>
                <div class="campoFormulario"><label for="tipo">Tipo de produto *</label><select id="tipo" name="tipo" required>
                   <option value="">Selecione</option><option value="roupa" <%= valores.tipo === 'roupa' ? 'selected' : '' %>>Roupa</option>
                   <option value="calcado" <%= valores.tipo === 'calcado' ? 'selected' : '' %>>Calçado</option>
                   <option value="outro" <%= valores.tipo === 'outro' ? 'selected' : '' %>>Acessório / tamanho único</option></select></div>
                <fieldset class="campoFormulario campoGrande grupoOpcoes"><legend>Tamanhos disponíveis *</legend>
                <div id="grupoTamanhos" class="grupoTamanhos" data-selecionados="<%= Array.isArray(valores.tamanhos) ? valores.tamanhos.join(',') : (valores.tamanhos || '') %>"></div>
                <small>Selecione um ou mais tamanhos; as opções mudam conforme o tipo.</small></fieldset>
                <div class="campoFormulario campoGrande"><label for="cores">Cores *</label><input type="text" id="cores" name="cores" value="<%= valores.cores || '' %>" maxlength="819" required placeholder="Ex.: Preto, Branco"><small>Separe por vírgula.</small></div>
                <div class="campoFormulario campoGrande"><label for="imagens">Imagens *</label><textarea id="imagens" name="imagens" rows="3" maxlength="20500" required placeholder="/imagensUCE/camisaAlemanha.png"><%= valores.imagens || '' %></textarea><small>Uma URL HTTP/HTTPS ou caminho existente em /imagensUCE/ por linha, até 10 imagens. A primeira é a imagem principal.</small></div>
                <div class="campoFormulario campoGrande"><label for="descricao">Descrição *</label><textarea id="descricao" name="descricao" rows="4" minlength="10" maxlength="5000" required><%= valores.descricao || '' %></textarea></div>
                <div class="campoFormulario campoGrande"><label for="detalhes">Detalhes técnicos</label><textarea id="detalhes" name="detalhes" rows="3" maxlength="5020" placeholder="Material: Poliéster&#10;Modelagem: Regular"><%= valores.detalhes || '' %></textarea><small>Um detalhe por linha, até 20 itens.</small></div>
                <fieldset class="campoFormulario campoGrande grupoOpcoes"><legend>Exibição na loja</legend>
                    <% const selecionadas = Array.isArray(valores.tags) ? valores.tags : [valores.tags]; %>
                    <% [['oferta', 'Ofertas do dia'], ['esporte', 'Esportes'], ['streetwear', 'Streetwear']].forEach(function ([valor, rotulo]) { %>
                    <label class="opcaoCheckbox"><input type="checkbox" name="tags" value="<%= valor %>" <%= selecionadas.includes(valor) ? 'checked' : '' %>><span><%= rotulo %></span></label>
                    <% }) %><small>O produto também aparecerá automaticamente em Novidades.</small>
                </fieldset>
                <p id="alertaValidacaoProduto" class="mensagemFormulario mensagemErro alertaValidacaoProduto campoGrande" role="alert" hidden>O produto não foi enviado. Confira os campos destacados e tente novamente.</p>
                <div class="acoesFormulario campoGrande"><a href="/seusdados.html" class="cancelarCadastro">Cancelar</a><button type="submit"><%= editando ? "Salvar alterações" : "Cadastrar Produto" %></button></div>
            </form>
        </article>
        <% if (listaProdutos && listaProdutos.length) { %>
        <article class="cardFormulario formularioProdutosExistentes">
          <h2>Produtos já cadastrados</h2>
          <p>Edite os dados e tamanhos sem excluir o produto da loja.</p>
          <div class="tabelaAdministrativa"><table><thead><tr><th>Produto</th><th>Marca</th><th>Categoria</th><th>Ação</th></tr></thead><tbody>
          <% listaProdutos.forEach(function (item) { %>
            <tr><td><%= item.nome %></td><td><%= item.marca %></td><td><%= categorias[item.categoria] || item.categoria %></td>
            <td><a href="/cadastrarproduto.html?editar=<%= encodeURIComponent(item.id) %>">Editar</a></td></tr>
          <% }) %>
          </tbody></table></div>
        </article><% } %>
    </section>
</main>
<%- include('../partials/scripts', { scripts: ['core', 'conta', 'cadastrarproduto'] }) %>
</body>
</html>
