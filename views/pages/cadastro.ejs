<%- include('../partials/head', { titulo: 'Criar conta | Tau Sports', css: ['global', 'components', 'login', 'header', 'footer', 'validacao-senha'] }) %>
<body>
<%- include('../partials/header-login') %>
<main class="login-page">
    <section class="login-container">
        <div class="login-banner"><div class="overlay"></div></div>
        <div class="login-box">
            <div class="login-header"><h1>Crie sua conta</h1><p>Cadastre-se para acessar a Taú Sports.</p></div>
            <% if (erro) { %><p class="mensagemFormulario mensagemErro" role="alert"><%= erro %></p><% } %>
            <form class="login-form" action="/cadastro" method="post" data-validar-senha>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="input-group"><label for="nome">Nome completo</label><input class="input" type="text" id="nome" name="nome" value="<%= valores.nome || '' %>" autocomplete="name" minlength="3" maxlength="100" required></div>
                <div class="input-group"><label for="email">E-mail</label><input class="input" type="email" id="email" name="email" value="<%= valores.email || '' %>" autocomplete="username" maxlength="100" required></div>
                <div class="input-group"><label for="cpf">CPF</label><input class="input" type="text" id="cpf" name="cpf" value="<%= valores.cpf || '' %>" inputmode="numeric" maxlength="14" placeholder="000.000.000-00" autocomplete="off" required></div>
                <div class="input-group"><label for="telefone">Telefone</label><input class="input" type="tel" id="telefone" name="telefone" value="<%= valores.telefone || '' %>" maxlength="20" placeholder="(00) 00000-0000" autocomplete="tel" required></div>
                <div class="input-group"><label for="senha">Senha</label><input class="input" type="password" id="senha" name="senha" autocomplete="new-password" minlength="8" maxlength="128" required></div>
                <div class="forcaSenha" aria-live="polite">
                    <p data-forca-texto>Força da senha: —</p>
                    <div class="forcaSenhaBarra" data-forca-barra></div>
                    <ul class="requisitosSenha">
                        <li data-requisito="tamanho">De 8 a 128 caracteres</li>
                        <li data-requisito="maiuscula">Uma letra maiúscula (A-Z)</li>
                        <li data-requisito="minuscula">Uma letra minúscula (a-z)</li>
                        <li data-requisito="numero">Um número (0-9)</li>
                        <li data-requisito="especial">Um caractere especial (ex.: ! @ #)</li>
                    </ul>
                    <p class="erroSenha" data-erro-senha role="alert"></p>
                </div>
                <div class="input-group"><label for="confirmarSenha">Confirme a senha</label><input class="input" type="password" id="confirmarSenha" name="confirmarSenha" autocomplete="new-password" minlength="8" maxlength="128" required></div>
                <button type="submit" class="btn btn-primary login-btn">Criar conta</button>
            </form>
            <div class="login-footer"><p>Já possui uma conta? <a href="/login.html">Entrar</a></p></div>
        </div>
    </section>
</main>
<%- include('../partials/scripts', { scripts: ['core', 'regras-senha', 'validacao-senha-formulario'] }) %>
</body>
</html>
