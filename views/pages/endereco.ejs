<%- include('../partials/head', {
    titulo: 'Taú Sports | Minha Conta',
    css: ['global', 'header', 'footer', 'pedidos', 'components', 'cards', 'seusdados', 'endereco']
}) %>
<body>

<%- include('../partials/header') %>

<main class="paginaUsuario">
    <%- include('../partials/conta-menu', { ativo: 'endereco' }) %>

<section class="perfilInformacao perfilEndereco" aria-labelledby="tituloSeusDados">
    

    <article class="cardFormulario">
    <div class="cardFormularioCabecalho">
        <h2>Endereço principal</h2>
        <p>Cadastre ou atualize o endereço usado nas suas entregas.</p>
    </div>

    <div id="listaEnderecos" class="enderecosExistentes" aria-live="polite"></div>
    <button class="cancelarCadastro" id="novoEndereco" type="button">+ Cadastrar outro endereço</button>
    <form class="formUsuario" action="#" method="post">
        <div class="campoFormulario">
            <label for="cep">CEP</label>
            <input
                type="text"
                id="cep"
                name="cep"
                placeholder="00000-000"
                autocomplete="postal-code"
                inputmode="numeric"
            >
        </div>

        <div class="campoFormulario" id="select">
            <label for="estado">Estado</label>
            <select id="estado" name="estado" autocomplete="address-level1">
                <option value="">Selecione</option>
                <option value="SP">São Paulo</option>
                <option value="RJ">Rio de Janeiro</option>
                <option value="MG">Minas Gerais</option>
                <option value="PR">Paraná</option>
            </select>
        </div>

        <div class="campoFormulario campoGrande">
            <label for="endereco">Endereço</label>
            <input
                type="text"
                id="endereco"
                name="endereco"
                placeholder="Rua, avenida ou travessa"
                autocomplete="address-line1"
            >
        </div>

        <div class="campoFormulario">
            <label for="numero">Número</label>
            <input
                type="text"
                id="numero"
                name="numero"
                placeholder="123"
                autocomplete="address-line2"
            >
        </div>

        <div class="campoFormulario">
            <label for="bairro">Bairro</label>
            <input
                type="text"
                id="bairro"
                name="bairro"
                placeholder="Centro"
                autocomplete="address-level3"
            >
        </div>

        <div class="campoFormulario">
            <label for="cidade">Cidade</label>
            <input
                type="text"
                id="cidade"
                name="cidade"
                placeholder="Campinas"
                autocomplete="address-level2"
            >
        </div>

        <div class="campoFormulario">
            <label for="complemento">Complemento</label>
            <input
                type="text"
                id="complemento"
                name="complemento"
                placeholder="Apartamento, bloco, casa..."
                autocomplete="address-line2"
            >
        </div>

        <div class="acoesFormulario campoGrande">
            <button type="submit">Salvar endereço</button>
        </div>
    </form>
</article>

<article class="cardFormulario">
    <div class="cardFormularioCabecalho">
        <h2>Informações de entrega</h2>
        <p>Adicione referências para facilitar a entrega dos seus pedidos.</p>
    </div>

    <form class="formUsuario" action="#" method="post">
        <div class="campoFormulario campoGrande">
            <label for="nomeEndereco">Nome do endereço</label>
            <input
                type="text"
                id="nomeEndereco"
                name="nomeEndereco"
                placeholder="Casa, trabalho, faculdade..."
            >
        </div>

        <div class="campoFormulario campoGrande">
            <label for="referencia">Ponto de referência</label>
            <input
                type="text"
                id="referencia"
                name="referencia"
                placeholder="Próximo ao mercado, portão azul..."
            >
        </div>

        <fieldset class="campoFormulario campoGrande grupoOpcoes">
            <legend>Tipo de endereço</legend>

            <label class="opcaoRadio" for="enderecoResidencial">
                <input
                    type="radio"
                    id="enderecoResidencial"
                    name="tipoEndereco"
                    value="residencial"
                >
                <span>Residencial</span>
            </label>

            <label class="opcaoRadio" for="enderecoComercial">
                <input
                    type="radio"
                    id="enderecoComercial"
                    name="tipoEndereco"
                    value="comercial"
                >
                <span>Comercial</span>
            </label>
        </fieldset>

        <fieldset class="campoFormulario campoGrande grupoOpcoes">
            <legend>Preferências</legend>

            <label class="opcaoCheckbox" for="enderecoPadrao">
                <input
                    type="checkbox"
                    id="enderecoPadrao"
                    name="enderecoPadrao"
                    value="sim"
                >
                <span>Usar este endereço como padrão para entregas</span>
            </label>
        </fieldset>

        <div class="acoesFormulario campoGrande">
            <button type="submit">Salvar informações</button>
        </div>
    </form>
</article>
</section>
</main>

<%- include('../partials/scripts', { scripts: ['core', 'conta'] }) %>
</body>
</html>
