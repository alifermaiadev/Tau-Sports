<%- include('../partials/head', { titulo: 'Complete seu cadastro | Taú Sports', css: ['global', 'components', 'login', 'header', 'footer'] }) %>
<body>
<%- include('../partials/header-login') %>
<main class="login-page cadastro-page">
    <section class="login-container">
        <div class="login-banner"><div class="overlay"></div></div>
        <div class="login-box">
            <div class="login-header">
                <h1>Complete seu cadastro</h1>
                <p>Você entrou com <%= provedor === 'google' ? 'Google' : 'Facebook' %>. Precisamos destes dados para criar sua conta Tau Sports.</p>
            </div>
            <% if (erro) { %><p class="mensagemFormulario mensagemErro" role="alert"><%= erro %></p><% } %>
            <form class="login-form" action="/auth/social/completar" method="post">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="input-group">
                    <label for="nome">Nome completo</label>
                    <input class="input" type="text" id="nome" name="nome" value="<%= valores.nome || '' %>" autocomplete="name" minlength="3" maxlength="100" required>
                </div>
                <div class="input-group">
                    <label for="email">E-mail</label>
                    <input class="input" type="email" id="email" name="email" value="<%= valores.email || '' %>" autocomplete="email" maxlength="100" <%= emailDoProvedor ? 'readonly' : '' %> required>
                    <% if (emailDoProvedor) { %><small>Recebido do provedor de login.</small><% } %>
                </div>
                <div class="input-group">
                    <label for="cpf">CPF</label>
                    <input class="input" type="text" id="cpf" name="cpf" value="<%= valores.cpf || '' %>" inputmode="numeric" maxlength="14" placeholder="000.000.000-00" required>
                </div>
                <div class="input-group">
                    <label for="telefone">Telefone</label>
                    <input class="input" type="tel" id="telefone" name="telefone" value="<%= valores.telefone || '' %>" inputmode="tel" maxlength="20" placeholder="(00) 00000-0000" autocomplete="tel" required>
                </div>
                <button type="submit" class="btn btn-primary login-btn">Criar minha conta</button>
            </form>
            <div class="login-footer"><p>Já tem cadastro? <a href="/login.html">Entrar com e-mail e senha</a></p></div>
        </div>
    </section>
</main>
<%- include('../partials/scripts', { scripts: ['core'] }) %>
</body>
</html>
