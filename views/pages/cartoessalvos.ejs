<%- include('../partials/head', {
    titulo: 'Taú Sports | Minha Conta',
    css: ['global', 'header', 'footer', 'pedidos', 'components', 'cards', 'cartoessalvos', 'seusdados']
}) %>
<body>

<%- include('../partials/header') %>

<main class="paginaUsuario">
    <%- include('../partials/conta-menu', { ativo: 'cartoessalvos' }) %>

<section class="perfilInformacao perfilEndereco" aria-labelledby="tituloSeusDados">
    

    

<article class="cardFormulario">
    <div class="cardFormularioCabecalho">
        <h2>Cartões salvos</h2>
        <p>Gerencie os cartões cadastrados na sua conta.</p>
    </div>

    <button type="button" id="abrirCadastroCartao" class="botaoAdicionarCartao" aria-expanded="false" aria-controls="formCartao">+ Adicionar cartão de teste</button>
    <form id="formCartao" class="formUsuario formularioCartao" hidden>
      <p class="campoGrande avisoTeste">Ambiente de demonstração: não informe dados reais de cartão. Nenhum pagamento será processado.</p>
      <div class="campoFormulario campoGrande"><label for="titularTeste">Nome do titular fictício</label><input id="titularTeste" name="titular" required maxlength="80" minlength="3" placeholder="Cliente Teste" autocomplete="off"></div>
      <div class="campoFormulario"><label for="bandeiraTeste">Bandeira</label><select id="bandeiraTeste" name="bandeira"><option value="visa">Visa (teste)</option><option value="mastercard">Mastercard (teste)</option></select></div>
      <div class="campoFormulario"><label for="finalTeste">4 últimos dígitos fictícios</label><input id="finalTeste" name="final" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" placeholder="4242" required autocomplete="off"></div>
      <div class="campoFormulario"><label for="validadeTeste">Validade fictícia (MM/AA)</label><input id="validadeTeste" name="validade" type="text" pattern="(0[1-9]|1[0-2])/[0-9]{2}" maxlength="5" placeholder="12/29" required autocomplete="off"></div>
      <div class="acoesFormulario campoGrande"><button type="button" id="cancelarCartaoTeste" class="botaoSecundario">Cancelar</button><button type="submit">Salvar cartão de teste</button></div>
    </form>
    <div class="listaCartoes" aria-live="polite"></div>
</article>
</section>
</main>

<%- include('../partials/scripts', { scripts: ['core', 'conta'] }) %>
</body>
</html>
